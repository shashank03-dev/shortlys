{
  "name": "shortly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --config vitest.coverage.config.mjs --coverage",
    "test:load": "node --env-file=.env.test scripts/load-test.mjs",
    "verify": "npm run lint && npm run test && npm run build",
    "postinstall": "prisma generate",
    "test:db": "node scripts/setup-test-db.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.8",
    "@prisma/client": "6.18.0",
    "@vercel/analytics": "^1.5.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "mongodb": "^6.20.0",
    "nanoid": "^5.1.6",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.1.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dotenv": "^6.1.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "6.18.0",
    "tailwindcss": "^4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "@prisma/config": {
      "effect": "^3.21.0",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
